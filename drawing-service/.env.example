# Server-side only. Never place this value in Android, GitHub, or logs.
OPENAI_API_KEY=

# Sensitive JSON object: lowercase device ID -> lowercase SHA-256 token hash.
# Maximum 20 devices. Store only hashes here; never store the raw QR token.
RAMSIERS_DRAWING_DEVICE_TOKEN_HASHES=

# Primary fixed vision-capable model. The service never calls the Models API.
OPENAI_DRAWING_MODEL=gpt-5.6-sol

# Off by default. Set an explicit model ID only if a reviewed fallback is desired.
OPENAI_DRAWING_FALLBACK_MODEL=off

# Optional A/B control. Only medium or high is accepted; production defaults to high.
OPENAI_REASONING_EFFORT=high

# Clamped by the service to 15,000-165,000 milliseconds, below Vercel's 180-second limit.
OPENAI_TIMEOUT_MS=160000
