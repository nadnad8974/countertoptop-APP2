# Server-side only. Never place this value in Android, GitHub, or logs.
OPENAI_API_KEY=

# Sensitive JSON object: lowercase device ID -> lowercase SHA-256 token hash.
# Maximum 20 devices. Store only hashes here; never store the raw QR token.
RAMSIERS_DRAWING_DEVICE_TOKEN_HASHES=

# Production analysis is fixed in code to gpt-5.6-sol, original image detail,
# medium reasoning, one request, no fallback, and a 90,000 ms timeout.
# Legacy model, fallback, reasoning, and timeout environment variables are ignored.
