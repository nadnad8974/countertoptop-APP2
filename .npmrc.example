# Copy this file to .npmrc and replace placeholders.
# Example:
#   cp .npmrc.example .npmrc
#
# Use your organization's npm proxy/mirror registry (Artifactory/Nexus/Verdaccio).
registry=https://<your-internal-npm-registry>/

# Optional scoped registry override (if your org scopes packages):
# @your-scope:registry=https://<your-internal-npm-registry>/

# Auth token for private registry (preferred over username/password in CI)
# //your-internal-npm-registry/:_authToken=<YOUR_TOKEN>

# Corporate proxy (only if required by your environment)
# proxy=http://proxy.company.local:8080
# https-proxy=http://proxy.company.local:8080

strict-ssl=true
